# Neon
NEON_AUTH_BASE_URL=https://your-project.neonauth.example/neondb/auth
NEON_AUTH_COOKIE_SECRET=your-32-byte-cookie-secret
NEXT_PUBLIC_NEON_DATA_API_URL=https://your-project.apirest.example/neondb/rest/v1
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Google OAuth — required for "Write in Google Docs" feature
# Get these from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google AI Studio — required for AI features (brainstorm, voice check, etc.)
# Get a free API key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key

# Optional local-only ChatGPT plan connection (never enables hosted access)
CHATGPT_LOCAL_ENABLED=false
CHATGPT_LOCAL_ORIGIN=http://127.0.0.1:3000

# Optional Google model override; verify availability for your key first
# GOOGLE_GENERATIVE_AI_MODEL=your-available-model
